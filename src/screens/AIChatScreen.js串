import React, { useState, useEffect, useRef } from 'react';
import {
    View,
    Text,
    StyleSheet,
    TextInput,
    TouchableOpacity,
    FlatList,
    KeyboardAvoidingView,
    Platform,
    ActivityIndicator,
    ScrollView,
    Dimensions
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { COLORS, FONTS, SIZES } from '../constants/Theme';
import { AnimatedCard, GlassCard } from '../components';

const { width } = Dimensions.get('window');

const QUICK_ACTIONS = [
    "Protein tips 🥩",
    "Workout plan 🏋️‍♂️",
    "Fat loss help 🔥",
    "Stretching 🧘",
    "Water goal 💧"
];

const AIChatScreen = ({ navigation }) => {
    const [messages, setMessages] = useState([
        {
            _id: 1,
            text: "Hello Alex! I'm your Elite AI Coach. Ready to reach the next level? Ask me anything about your training, nutrition, or recovery.",
            createdAt: new Date(),
            user: { _id: 2, name: 'AI' },
        }
    ]);
    const [inputText, setInputText] = useState('');
    const [isTyping, setIsTyping] = useState(false);
    const flatListRef = useRef(null);

    const sendMessage = (text) => {
        const messageText = text || inputText;
        if (messageText.trim().length === 0) return;

        const newMessage = {
            _id: Math.round(Math.random() * 1000000),
            text: messageText,
            createdAt: new Date(),
            user: { _id: 1, name: 'User' },
        };

        setMessages(prev => [newMessage, ...prev]);
        setInputText('');
        setIsTyping(true);

        // Mock AI Response
        setTimeout(() => {
            const responses = [
                "Based on your current levels, I recommend increasing your protein by 20g today to support muscle recovery from yesterday's lift.",
                "Your activity rings are looking great! Try a brisk 10-minute walk after lunch to keep that metabolism high.",
                "Consistency is key! You're on a 5-day streak. Don't let up now, you're becoming a pro.",
                "For better sleep recovery, try avoiding caffeine after 2 PM. Your body will thank you.",
                "If you're feeling sore, active recovery like light yoga or a slow walk is better than total rest."
            ];
            const randomResponse = responses[Math.floor(Math.random() * responses.length)];

            const aiMessage = {
                _id: Math.round(Math.random() * 1000000),
                text: randomResponse,
                createdAt: new Date(),
                user: { _id: 2, name: 'AI' },
            };

            setMessages(prev => [aiMessage, ...prev]);
            setIsTyping(false);
        }, 1500);
    };

    const renderMessage = ({ item, index }) => {
        const isUser = item.user._id === 1;
        return (
            <AnimatedCard delay={index * 50} style={[
                styles.messageContainer,
                isUser ? styles.userContainer : styles.aiContainer
            ]}>
                <View style={[
                    styles.bubble,
                    isUser ? styles.userBubble : styles.aiBubble
                ]}>
                    {!isUser && (
                        <View style={styles.aiAvatarSmall}>
                            <Ionicons name="sparkles" size={12} color={COLORS.primary} />
                        </View>
                    )}
                    <Text style={[
                        styles.messageText,
                        isUser ? styles.userText : styles.aiText
                    ]}>{item.text}</Text>
                </View>
                <Text style={styles.timeText}>
                    {item.createdAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                </Text>
            </AnimatedCard>
        );
    };

    return (
        <SafeAreaView style={styles.container} edges={['bottom', 'left', 'right']}>
            {/* Header */}
            <View style={styles.header}>
                <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backBtn}>
                    <Ionicons name="chevron-back" size={24} color={COLORS.text} />
                </TouchableOpacity>
                <View style={styles.headerTitleContainer}>
                    <Text style={styles.headerTitle}>AI Coach</Text>
                    <View style={styles.statusContainer}>
                        <View style={styles.statusDot} />
                        <Text style={styles.statusText}>Always Ready</Text>
                    </View>
                </View>
                <TouchableOpacity style={styles.optionsBtn}>
                    <Ionicons name="ellipsis-horizontal" size={24} color={COLORS.text} />
                </TouchableOpacity>
            </View>

            <FlatList
                ref={flatListRef}
                data={messages}
                keyExtractor={item => item._id.toString()}
                renderItem={renderMessage}
                inverted
                showsVerticalScrollIndicator={false}
                contentContainerStyle={styles.listContent}
                ListHeaderComponent={() => isTyping && (
                    <View style={styles.typingIndicator}>
                        <ActivityIndicator size="small" color={COLORS.primary} />
                        <Text style={styles.typingText}>Coach is thinking...</Text>
                    </View>
                )}
            />

            <KeyboardAvoidingView 
                behavior={Platform.OS === "ios" ? "padding" : "height"} 
                keyboardVerticalOffset={Platform.OS === "ios" ? 0 : 20}
            >
                {/* Quick Actions */}
                <ScrollView 
                    horizontal 
                    showsHorizontalScrollIndicator={false} 
                    style={styles.quickActions}
                    contentContainerStyle={styles.quickActionsContent}
                >
                    {QUICK_ACTIONS.map((action, i) => (
                        <TouchableOpacity 
                            key={i} 
                            style={styles.actionChip}
                            onPress={() => sendMessage(action)}
                        >
                            <Text style={styles.actionChipText}>{action}</Text>
                        </TouchableOpacity>
                    ))}
                </ScrollView>

                {/* Input Area */}
                <View style={styles.inputContainer}>
                    <GlassCard style={styles.inputGlass}>
                        <TextInput
                            style={styles.input}
                            placeholder="Type a message..."
                            placeholderTextColor={COLORS.gray200}
                            value={inputText}
                            onChangeText={setInputText}
                            multiline
                        />
                        <TouchableOpacity 
                            onPress={() => sendMessage()} 
                            style={styles.sendBtn}
                            disabled={inputText.trim().length === 0}
                        >
                            <LinearGradient
                                colors={inputText.trim().length > 0 ? COLORS.primaryGradient : ['#E2E8F0', '#CBD5E1']}
                                style={styles.sendGradient}
                            >
                                <Ionicons name="send" size={18} color={COLORS.white} />
                            </LinearGradient>
                        </TouchableOpacity>
                    </GlassCard>
                </View>
            </KeyboardAvoidingView>
        </SafeAreaView>
    );
};

