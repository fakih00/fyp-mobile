{
  "name": "mobile_fitness",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "train:nutrition-ai": "python ml/nutrition_ai/nutricore_model.py --train",
    "preprocess:workout-ai": "python scripts/import-traincore-kaggle-dataset.py",
    "train:workout-ai": "python ml/workout_ai/traincore_model.py --train",
    "train:prediction-ai": "php scripts/test-prediction-ai.php",
    "train:all-ai": "python scripts/train-all-ai.py",
    "validate:exercise-ai": "node scripts/validate-exercise-ai.js && node scripts/test-exercise-ai.js && python scripts/validate-video-pose-analyzer.py",
    "train:exercise-ai": "node scripts/validate-exercise-ai.js && node scripts/test-exercise-ai.js && python scripts/validate-video-pose-analyzer.py && python scripts/smoke-video-analyzer-all-exercises.py",
    "setup:exercise-video-ai": "python -m pip install --target ml/exercise_ai/vendor -r ml/exercise_ai/requirements.txt"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/core": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@react-navigation/routers": "^7.5.3",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.2",
    "expo-blur": "~57.0.0",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.1",
    "expo-linear-gradient": "~57.0.0",
    "expo-sensors": "~57.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~57.0.1",
    "qrcode-terminal": "^0.12.0",
    "react-refresh": "^0.18.0"
  }
}
